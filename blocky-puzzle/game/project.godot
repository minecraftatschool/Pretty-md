config_version=4

[application]

config/name="Blocky Puzzle"
config/use_custom_user_dir=true
config/custom_user_dir_name="Bloc Puzzle"
run/main_scene="res://main.tscn"
config/icon="res://icon.png"
config/quit_on_go_back=false
boot_splash/show_image=false
boot_splash/bg_color=Color( 0.42, 0.259, 0.149, 1 )

[display]

window/size/width=720
window/size/height=1280
window/handheld/orientation="portrait"
window/stretch/mode="2d"
window/stretch/aspect="expand"

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[rendering]

quality/driver/driver_name="GLES2"
vram_compression/import_etc=true
vram_compression/import_etc2=false
environment/default_clear_color=Color( 0.078, 0.102, 0.2, 1 )
